  "captions": [
    {
      "id": "group0",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Only have time"
    },
    {
      "id": "group1",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "for three things in Hanoi?"
    },
    {
      "id": "group2",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Here’s how I’d spend it."
    },
    {
      "id": "group3",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "First, find a little"
    },
    {
      "id": "group4",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "local food spot."
    },
    {
      "id": "group5",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Start your morning"
    },
    {
      "id": "group6",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "with a warm bowl"
    },
    {
      "id": "group7",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "of phở,"
    },
    {
      "id": "group8",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "or try bún chả"
    },
    {
      "id": "group9",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "for lunch."
    },
    {
      "id": "group10",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Take your time,"
    },
    {
      "id": "group11",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "watch the street outside,"
    },
    {
      "id": "group12",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "and enjoy the little"
    },
    {
      "id": "group13",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "details around you."
    },
    {
      "id": "group14",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Second, stop for"
    },
    {
      "id": "group15",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Vietnamese coffee."
    },
    {
      "id": "group16",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Try an egg coffee,"
    },
    {
      "id": "group17",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "or order your favourite"
    },
    {
      "id": "group18",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "and find a seat"
    },
    {
      "id": "group19",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "where you can watch"
    },
    {
      "id": "group20",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Hanoi go by."
    },
    {
      "id": "group21",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Sometimes the best part"
    },
    {
      "id": "group22",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "of exploring"
    },
    {
      "id": "group23",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "is taking a break."
    },
    {
      "id": "group24",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "And third,"
    },
    {
      "id": "group25",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "discover the city on foot."
    },
    {
      "id": "group26",
      "width": 850,
      "scrollWidth": 850,
      "height": 145,
      "text": "Walk around Hoàn Kiếm Lake,"
    },
    {
      "id": "group27",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "then wander into"
    },
    {
      "id": "group28",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "the Old Quarter."
    },
    {
      "id": "group29",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Look up at"
    },
    {
      "id": "group30",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "the old balconies,"
    },
    {
      "id": "group31",
      "width": 850,
      "scrollWidth": 850,
      "height": 145,
      "text": "peek down the little alleys,"
    },
    {
      "id": "group32",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "and let yourself take"
    },
    {
      "id": "group33",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "the scenic route."
    },
    {
      "id": "group34",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Want to be"
    },
    {
      "id": "group35",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "in the photos too?"
    },
    {
      "id": "group36",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Explore Hanoi"
    },
    {
      "id": "group37",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "with a local photographer"
    },
    {
      "id": "group38",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "and take home memories"
    },
    {
      "id": "group39",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "of your day."
    },
    {
      "id": "group40",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "Save this"
    },
    {
      "id": "group41",
      "width": 850,
      "scrollWidth": 850,
      "height": 72,
      "text": "for your Hanoi trip."
    }
  ],
