{
  "name": "travelframe.vn",
  "version": "1.0.0",
  "description": "",
  "main": "Technology-Automation/MCP/travelframe-readonly.mjs",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:mcp",
    "test:mcp": "node --test Technology-Automation/Tests/legacy/mcp/*.test.mjs Technology-Automation/Tests/mcp/meta-ads-*.test.mjs",
    "test:triage": "node --test Technology-Automation/Tests/typesafe_lead_triage.test.mjs",
    "test:classifier": "node --test Technology-Automation/Tests/typesafe_content_classifier.test.mjs",
    "triage": "node Technology-Automation/Scripts/typesafe_lead_triage.mjs",
    "test:skills": "python3 -m unittest Technology-Automation.Tests.test_skill_manifest Technology-Automation.Tests.test_skill_contracts Technology-Automation.Tests.test_skill_sync -v",
    "test:workspace": "python3 -m unittest discover -s Technology-Automation/Tests -p 'test_*.py'",
    "skills:check": "python3 Technology-Automation/Scripts/validate_skills.py --root . && python3 Technology-Automation/Scripts/sync_skills.py --root . --check",
    "skills:sync": "python3 Technology-Automation/Scripts/sync_skills.py --root . --write",
    "workspace:check": "python3 Technology-Automation/Scripts/workspace_check.py --root .",
    "mcp:travelframe": "node Technology-Automation/MCP/travelframe-readonly.mjs",
    "mcp:google-analytics": "node Technology-Automation/MCP/google-analytics-readonly.mjs",
    "openseo:info": "node -e \"console.log('OpenSEO Platform: Technology-Automation/Tools/open-seo | Runbook: Technology-Automation/Runbooks/OpenSEO-Runbook.md')\"",
    "openreply:info": "node -e \"console.log('OpenReply Platform: Technology-Automation/Tools/openreply | Runbook: Technology-Automation/Runbooks/OpenReply-Runbook.md')\"",
    "media:search": "node Technology-Automation/Scripts/fetch_media_asset.mjs search",
    "media:download": "node Technology-Automation/Scripts/fetch_media_asset.mjs download",
    "test:meta-ads": "node --test Technology-Automation/Tests/mcp/meta-ads-*.test.mjs",
    "mcp:meta-ads": "node Technology-Automation/MCP/travelframe-meta-ads.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google-analytics/data": "^7.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
